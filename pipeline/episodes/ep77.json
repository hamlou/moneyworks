   "sfx": [
    {
     "s": "ding",
     "at": "sentence"
    },
    {
     "s": "stamp",
     "at": "money"
    }
   ]
  },
  {
   "id": "r3",
   "text": "Tonight my landlord is asleep. And for the first time a tiny piece of my money is working the night shift too.",
   "card": {
    "t": "My money works nights now.",
    "dark": true
   },
   "sfx": [
    {
     "s": "pack/01_boom",
     "at": "night"
    }
   ],
   "pause": 0.5
  },
