{"id": "usa30", "title": "What If The USA Disappeared For 30 Days? #shorts", "w": 1080, "h": 1920, "frames": 1189, "voice": "usa30/voice.flac", "beats": [{"from": 0, "to": 81, "say": "What if the USA disappeared for thirty days?", "text": "USA GONE FOR 30 DAYS?", "focus": "USA", "highlight": ["USA"], "style": "gone", "dave": "shock", "fx": [{"type": "fade_country", "from": "USA", "to": "USA", "at": 22, "end": 81}]}, {"from": 81, "to": 187, "say": "Mexico gets hit first because eight out of ten things it sells go to the USA.", "text": "8 IN 10 SALES GONE", "focus": "MEX", "highlight": ["MEX"], "style": "loss", "dave": "worried", "fx": [{"type": "factory", "from": "MEX", "to": "MEX", "at": 141, "end": 187}, {"type": "arrow", "from": "MEX", "to": "USA", "at": 147, "end": 187}, {"type": "crack", "from": "MEX", "to": "USA", "at": 159, "end": 187}]}, {"from": 187, "to": 274, "say": "Canada too because three out of four of its sales go there.", "text": "CANADA LOSES 3 IN 4", "focus": "CAN", "highlight": ["CAN"], "style": "loss", "dave": "point", "fx": [{"type": "arrow", "from": "CAN", "to": "USA", "at": 240, "end": 274}, {"type": "crack", "from": "CAN", "to": "USA", "at": 254, "end": 274}]}, {"from": 274, "to": 399, "say": "Worse Mexico loses food too because almost all the corn it buys abroad is American.", "text": "NO MORE US CORN", "focus": "MEX", "highlight": ["MEX", "USA"], "style": "loss", "dave": "shock", "fx": [{"type": "grain", "from": "USA", "to": "MEX", "at": 344, "end": 399}, {"type": "crack", "from": "USA", "to": "MEX", "at": 370, "end": 399}]}, {"from": 399, "to": 522, "say": "Then gas jumps everywhere because the USA pumps more oil than any other country.", "text": "WORLD'S #1 OIL GONE", "focus": "WORLD", "highlight": ["USA"], "style": "gone", "dave": "worried", "fx": [{"type": "fire", "from": "USA", "to": "USA", "at": 411, "end": 522}, {"type": "oil", "from": "USA", "to": "USA", "at": 472, "end": 522}, {"type": "fade_country", "from": "USA", "to": "USA", "at": 496, "end": 522}]}, {"from": 522, "to": 643, "say": "So countries lose savings because over half the money they save is American dollars.", "text": "HALF THE SAVINGS = DOLLARS", "focus": "WORLD", "highlight": ["USA"], "style": "gone", "dave": "shock", "fx": [{"type": "money", "from": "USA", "to": "USA", "at": 546, "end": 643}, {"type": "crack", "from": "USA", "to": "USA", "at": 612, "end": 643}]}, {"from": 643, "to": 693, "say": "Yet some countries love this.", "text": "BUT WHO WINS?", "focus": "WORLD", "highlight": ["BRA", "SAU", "RUS", "DEU"], "style": "win", "dave": "laugh", "fx": [{"type": "arrow", "from": "USA", "to": "BRA", "at": 662, "end": 693}]}, {"from": 693, "to": 785, "say": "Brazil wins because it already ships more soybeans than anyone.", "text": "BRAZIL: SOYBEAN KING", "focus": "BRA", "highlight": ["BRA"], "style": "win", "dave": "cheer", "fx": [{"type": "grain", "from": "BRA", "to": "CHN", "at": 745, "end": 785}, {"type": "ship", "from": "BRA", "to": "CHN", "at": 729, "end": 785}]}, {"from": 785, "to": 902, "say": "Saudi Arabia and Russia win because every barrel they sell is suddenly worth more.", "text": "OIL WORTH MORE", "focus": "SAU", "highlight": ["SAU", "RUS"], "style": "win", "dave": "point", "fx": [{"type": "oil", "from": "SAU", "to": "CHN", "at": 835, "end": 902}, {"type": "oil", "from": "RUS", "to": "CHN", "at": 850, "end": 902}, {"type": "money", "from": "CHN", "to": "SAU", "at": 871, "end": 902}]}, {"from": 902, "to": 1012, "say": "So Europe steps up because the euro is already the number two savings money.", "text": "EURO = NEW #1?", "focus": "DEU", "highlight": ["DEU", "FRA", "ITA", "ESP", "NLD"], "style": "win", "dave": "think", "fx": [{"type": "money", "from": "DEU", "to": "DEU", "at": 906, "end": 1012}]}, {"from": 1012, "to": 1117, "say": "But nobody wins for long because one in four dollars on Earth is made in the USA.", "text": "1 IN 4 DOLLARS = USA", "focus": "WORLD", "highlight": ["USA"], "style": "gone", "dave": "shrug", "f