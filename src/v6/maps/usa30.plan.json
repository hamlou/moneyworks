{"id": "usa30", "title": "What If The USA Disappeared For 30 Days? #shorts", "w": 1080, "h": 1920, "frames": 1207, "voice": "usa30/voice.flac", "beats": [{"from": 0, "to": 82, "cam": 0, "say": "What if the USA disappeared for thirty days?", "text": "USA GONE FOR 30 DAYS?", "focus": "USA", "highlight": ["USA"], "style": "gone", "dave": "worried", "fx": [{"type": "fade_country", "from": "USA", "to": "USA", "at": 19, "end": 82, "word": "disappeared", "wf": 22}]}, {"from": 82, "to": 189, "cam": 68, "say": "Mexico gets hit first because eight out of ten things it sells go to the USA.", "text": "8 IN 10 SALES GONE", "focus": "MEX", "highlight": ["MEX"], "style": "loss", "dave": "worried", "fx": [{"type": "factory", "from": "MEX", "to": "MEX", "at": 138, "end": 189, "word": "sells", "wf": 141}, {"type": "arrow", "from": "MEX", "to": "USA", "at": 144, "end": 189, "word": "go", "wf": 147}, {"type": "crack", "from": "MEX", "to": "USA", "at": 157, "end": 189, "word": "USA", "wf": 160}]}, {"from": 189, "to": 275, "cam": 175, "say": "Canada too because three out of four of its sales go there.", "text": "CANADA LOSES 3 IN 4", "focus": "CAN", "highlight": ["CAN"], "style": "loss", "dave": "point", "fx": [{"type": "arrow", "from": "CAN", "to": "USA", "at": 239, "end": 275, "word": "sales", "wf": 242}, {"type": "crack", "from": "CAN", "to": "USA", "at": 252, "end": 275, "word": "there", "wf": 255}]}, {"from": 275, "to": 402, "cam": 269, "say": "Worse Mexico loses food too because almost all the corn it buys abroad is American.", "text": "NO MORE US CORN", "focus": "MEX", "highlight": ["MEX", "USA"], "style": "loss", "dave": "worried", "fx": [{"type": "grain", "from": "USA", "to": "MEX", "at": 342, "end": 402, "word": "corn", "wf": 345}, {"type": "crack", "from": "USA", "to": "MEX", "at": 368, "end": 402, "word": "American", "wf": 371}]}, {"from": 402, "to": 524, "cam": 398, "say": "Then gas jumps everywhere because the USA pumps more oil than any other country.", "text": "WORLD'S #1 OIL GONE", "focus": "WORLD", "highlight": ["USA"], "style": "gone", "dave": "worried", "fx": [{"type": "fire", "from": "USA", "to": "USA", "at": 410, "end": 524, "word": "gas", "wf": 413}, {"type": "oil", "from": "USA", "to": "USA", "at": 471, "end": 524, "word": "oil", "wf": 474}, {"type": "fade_country", "from": "USA", "to": "USA", "at": 496, "end": 524, "word": "country", "wf": 499}]}, {"from": 524, "to": 647, "cam": 524, "say": "So countries lose savings because over half the money they save is American dollars.", "text": "HALF THE SAVINGS = DOLLARS", "focus": "WORLD", "highlight": ["USA"], "style": "gone", "dave": "worried", "fx": [{"type": "money", "from": "USA", "to": "USA", "at": 545, "end": 647, "word": "savings", "wf": 548}, {"type": "crack", "from": "USA", "to": "USA", "at": 612, "end": 647, "word": "dollars", "wf": 615}]}, {"from": 647, "to": 696, "cam": 647, "say": "Yet some countries love this.", "text": "BUT WHO WINS?", "focus": "WORLD", "highlight": ["BRA", "SAU", "RUS", "DEU"], "style": "win", "dave": "shrug", "fx": [{"type": "arrow", "from": "USA", "to": "BRA", "at": 662, "end": 696, "word": "love", "wf": 665}]}, {"from": 696, "to": 788, "cam": 683, "say": "Brazil wins because it already ships more soybeans than anyone.", "text": "BRAZIL: SOYBEAN KING", "focus": "BRA", "highlight": ["BRA"], "style": "win", "dave": "point", "fx": [{"type": "grain", "from": "BRA", "to": "CHN", "at": 745, "end": 788, "word": "soybeans", "wf": 748}, {"type": "ship", "from": "BRA", "to": "CHN", "at": 729, "end": 788, "word": "ships", "wf": 732}]}, {"from": 788, "to": 906, "cam": 775, "say": "Saudi Arabia and Russia win because every barrel they sell is suddenly worth more.", "text": "OIL WORTH MORE", "focus": "SAU", "highlight": ["SAU", "RUS"], "style": "win", "dave": "point", "fx": [{"type": "oil", "from": "SAU", "to": "CHN", "at": 836, "end": 906, "word": "barrel", "wf": 839}, {"type": "oil", "from": "RUS", "to": "CHN", "at": 850, "end": 906, "word": "sell", "wf": 853}, {"type": "money", "from": "CHN", "to": "SAU", "at": 871, "end": 906, "word": "worth", "wf": 874}]}, {"from": 906, "to": 1017, "cam": 896, "say": "So Europe steps up because the euro is already the number two savings money.", "text": "EURO = NEW #1?", "focus": "DEU", "highlight": ["DEU", "FRA", "ITA", "ESP", "NLD"], "style": "win", "dave": "talk", "fx": [{"type": "money", "from": "DEU", "to": "DEU", "at": 943, "end": 1017, "word": "euro", "wf": 946}]}, {"from": 1017, "to": 1123, "cam": 1017, "say": "But nobody wins for long because one in four dollars on Earth is made in the USA.", "text": "1 IN 4 DOLLARS = USA", "focus": "WORLD", "highlight": ["USA"], "style": "gone", "dave": "shrug", "fx": [{"type": "money", "from": "USA", "to": "USA", "at": 1059, "end": 1123, "word": "dollars", "wf": 1062}, {"type": "fade_country", "from": "USA", "to": "USA", "at": 1092, "end": 1123, "word": "USA", "wf": 1095}]}, {"from": 1123, "to": 1207, "cam": 1123, "say": "That is why every country on this map fears one question.", "text": "THE ONE QUESTION", "focus": "USA", "highlight": ["USA"], "style": "gone", "dave": "talk", "fx": [{"type": "fade_country", "from": "USA", "to": "USA", "at": 1171, "end": 1207, "word": "question", "wf": 1174}]}], "music": [{"src": "darkest_child", "from": 0, "to": 82, "v": 0.15, "off": 210}, {"src": "investigations", "from": 82, "to": 393, "v": 0.15, "off": 210}, {"src": "darkest_child", "from": 402, "to": 515, "v": 0.15, "off": 210}, {"src": "darkest_child", "from": 524, "to": 647, "v": 0.15, "off": 210}, {"src": "life_of_riley", "from": 647, "to": 1008, "v": 0.15, "off": 210}, {"src": "darkest_child", "from": 1017, "to": 1114, "v": 0.15, "off": 210}, {"src": "darkest_child", "from": 1123, "to": 1207, "v": 0.15, "off": 210}], "sfx": [{"at": 0, "src": "ea1/reply_pop", "v": 0.4}, {"at": 0, "src": "ea1/k_stop", "v": 0.45}, {"at": 3, "src": "ea1/fail", "v": 0.5}, {"at": 22, "src": "ea1/deflate", "v": 0.5}, {"at": 68, "src": "ea1/photo_slide", "v": 0.4}, {"at