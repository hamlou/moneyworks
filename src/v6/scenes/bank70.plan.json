 "beats": [
  {
   "id": "b01",
   "from": 0,
   "to": 88,
   "say": "What if every bank in your country closed for six months?",
   "text": null,
   "scene": "A",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 0,
     "t": "EVERY BANK CLOSED?"
    }
   ]
  },
  {
   "id": "b02",
   "from": 88,
   "to": 169,
   "say": "Because in Ireland in nineteen seventy they really did.",
   "text": null,
   "scene": "B",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 100,
     "t": "IRELAND 1970"
    }
   ]
  },
  {
   "id": "b03",
   "from": 169,
   "to": 242,
   "say": "The bank workers went on strike and locked every door.",
   "text": null,
   "scene": "C",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 204,
     "t": "LOCKED"
    }
   ]
  },
  {
   "id": "b04",
   "from": 242,
   "to": 315,
   "say": "So nobody could take out a single coin of cash.",
   "text": null,
   "scene": "D",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 273,
     "t": "NOT ONE COIN"
    }
   ]
  },
  {
   "id": "b05",
   "from": 315,
   "to": 383,
   "say": "But people did not panic because they went to the pub.",
   "text": null,
   "scene": "E",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 364,
     "t": "SO\u2026 THE PUB"
    }
   ]
  },
  {
   "id": "b06",
   "from": 383,
   "to": 450,
   "say": "Eleven thousand pubs turned into banks.",
   "text": null,
   "scene": "F",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 383,
     "t": "11,000 PUBS = BANKS"
    }
   ]
  },
  {
   "id": "b07",
   "from": 450,
   "to": 530,
   "say": "You wrote a cheque and the barman gave you cash because he knew you.",
   "text": null,
   "scene": "G",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 509,
     "t": "HE KNEW YOU"
    }
   ]
  },
  {
   "id": "b08",
   "from": 530,
   "to": 606,
   "say": "People wrote cheques on any scrap of paper they could find.",
   "text": null,
   "scene": "H",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 557,
     "t": "ANY SCRAP OF PAPER"
    }
   ]
  },
  {
   "id": "b09",
   "from": 606,
   "to": 673,
   "say": "And they passed them around like money for six whole months.",
   "text": null,
   "scene": "I",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 641,
     "t": "6 WHOLE MONTHS"
    }
   ]
  },
  {
   "id": "b10",
   "from": 673,
   "to": 774,
   "say": "When the banks finally opened they found five billion pounds of cheques waiting.",
   "text": null,
   "scene": "J",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 708,
     "t": "\u00a35,000,000,000"
    }
   ]
  },
  {
   "id": "b11",
   "from": 774,
   "to": 858,
   "say": "Because the money was never in the bank it was in the trust.",
   "text": null,
   "scene": "K",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": [
    {
     "at": 836,
     "t": "IT WAS TRUST"
