 "beats": [
  {
   "id": "b01",
   "from": 0,
   "to": 75,
   "say": "What if your phone took one dollar every time you checked it?",
   "text": null,
   "scene": "lock_hook",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b02",
   "from": 75,
   "to": 135,
   "say": "Because you would be broke before lunch.",
   "text": null,
   "scene": "lock_broke",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b03",
   "from": 135,
   "to": 214,
   "say": "The average American checks their phone ninety six times a day.",
   "text": null,
   "scene": "screentime",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b04",
   "from": 214,
   "to": 274,
   "say": "That is once every ten minutes you are awake.",
   "text": null,
   "scene": "every10",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b05",
   "from": 274,
   "to": 366,
   "say": "So that is ninety six dollars a day just to look at a screen.",
   "text": null,
   "scene": "bank_day",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b06",
   "from": 366,
   "to": 463,
   "say": "And by the end of the year it is thirty five thousand dollars.",
   "text": null,
   "scene": "bank_year",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b07",
   "from": 463,
   "to": 551,
   "say": "That is a brand new car every year gone to notifications.",
   "text": null,
   "scene": "texts",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b08",
   "from": 551,
   "to": 610,
   "say": "But people your age check it twice as much.",
   "text": null,
   "scene": "screentime2",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b09",
   "from": 610,
   "to": 682,
   "say": "So you would pay seventy thousand dollars a year.",
   "text": null,
   "scene": "bank_year2",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b10",
   "from": 682,
   "to": 751,
   "say": "And the scary part is you would still keep checking it.",
   "text": null,
   "scene": "lock_spam",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
   "caps": []
  },
  {
   "id": "b11",
   "from": 751,
   "to": 834,
   "say": "Because the phone was never free and you already pay with your time.",
   "text": null,
   "scene": "time",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral",
