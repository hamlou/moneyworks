 "beats": [
  {
   "id": "b01",
   "from": 0,
   "to": 87,
   "say": "What if everyone on your street could see your salary?",
   "text": "EVERYONE SEES YOUR SALARY?",
   "scene": "street_hook",
   "dave": "worried",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b02",
   "from": 87,
   "to": 141,
   "say": "Because in Norway they actually can.",
   "text": "NORWAY REALLY DOES THIS",
   "scene": "norway",
   "dave": "point",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b03",
   "from": 141,
   "to": 254,
   "say": "You type any name into your phone and their income just pops up.",
   "text": null,
   "scene": "search",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b04",
   "from": 254,
   "to": 367,
   "say": "So people looked up their boss and their neighbor and even their ex",
   "text": null,
   "scene": "lookup",
   "dave": "shrug",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b05",
   "from": 367,
   "to": 479,
   "say": "sixteen million times in one year in a country of five million people.",
   "text": null,
   "scene": "count",
   "dave": "point",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b06",
   "from": 479,
   "to": 550,
   "say": "But then scientists measured how happy everyone was",
   "text": null,
   "scene": "happy",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b07",
   "from": 550,
   "to": 672,
   "say": "and nobody's paycheck changed yet the rich got happier and the poor got sadder.",
   "text": null,
   "scene": "happy",
   "dave": "worried",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b08",
   "from": 672,
   "to": 726,
   "say": "So Norway changed one tiny rule.",
   "text": null,
   "scene": "rule",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b09",
   "from": 726,
   "to": 822,
   "say": "Now when you look someone up they can see your name.",
   "text": null,
   "scene": "notif",
   "dave": "worried",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b10",
   "from": 822,
   "to": 909,
   "say": "And the searches crashed from sixteen million to two million.",
   "text": null,
   "scene": "crash",
   "dave": "point",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b11",
   "from": 909,
   "to": 980,
   "say": "Because people never wanted to know the number.",
   "text": null,
   "scene": "street_fade",
   "dave": "shrug",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b12",
   "from": 980,
   "to": 1051,
   "say": "They just wanted to look without getting caught.",
   "text": null,
   "scene": "peek",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b13",
