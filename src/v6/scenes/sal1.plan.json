 "beats": [
  {
   "id": "b01",
   "from": 0,
   "to": 65,
   "say": "What if everyone on your street could see your salary?",
   "text": "EVERYONE SEES YOUR SALARY?",
   "scene": "street_hook",
   "dave": "worried",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b02",
   "from": 65,
   "to": 129,
   "say": "Because in Norway they actually can.",
   "text": "NORWAY REALLY DOES THIS",
   "scene": "norway",
   "dave": "point",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b03",
   "from": 129,
   "to": 218,
   "say": "You type any name into your phone and their income just pops up.",
   "text": null,
   "scene": "search",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b04",
   "from": 218,
   "to": 301,
   "say": "So people looked up their boss and their neighbor and even their ex",
   "text": null,
   "scene": "lookup",
   "dave": "shrug",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b05",
   "from": 301,
   "to": 410,
   "say": "sixteen million times in one year in a country of five million people.",
   "text": null,
   "scene": "count",
   "dave": "point",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b06",
   "from": 410,
   "to": 485,
   "say": "But then scientists measured how happy everyone was",
   "text": null,
   "scene": "happy",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b07",
   "from": 485,
   "to": 602,
   "say": "and nobody's paycheck changed yet the rich got happier and the poor got sadder.",
   "text": null,
   "scene": "happy",
   "dave": "worried",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b08",
   "from": 602,
   "to": 665,
   "say": "So Norway changed one tiny rule.",
   "text": null,
   "scene": "rule",
   "dave": "talk",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b09",
   "from": 665,
   "to": 740,
   "say": "Now when you look someone up they can see your name.",
   "text": null,
   "scene": "notif",
   "dave": "worried",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b10",
   "from": 740,
   "to": 828,
   "say": "And the searches crashed from sixteen million to two million.",
   "text": null,
   "scene": "crash",
   "dave": "point",
   "fx": [],
   "highlight": [],
   "focus": "",
   "style": "neutral"
  },
  {
   "id": "b11",
