{"fps": 30, "total": 30.754125000000002, "hash": "d5a33ba67763f4ee", "chapters": [], "beats": [{"id": "b01", "text": "What if prices doubled every single day?", "start": 0.054000000000000006, "end": 1.814, "words": [{"text": "What", "start": 0.054000000000000006, "end": 0.19400000000000003}, {"text": "if", "start": 0.19400000000000003, "end": 0.294}, {"text": "prices", "start": 0.294, "end": 0.494}, {"text": "doubled", "start": 0.494, "end": 0.874}, {"text": "every", "start": 0.874, "end": 1.254}, {"text": "single", "start": 1.254, "end": 1.534}, {"text": "day?", "start": 1.534, "end": 1.814}]}, {"id": "b02", "text": "Because in Hungary in nineteen forty six it was even worse.", "start": 2.307, "end": 4.343, "words": [{"text": "Because", "start": 2.307, "end": 2.554}, {"text": "in", "start": 2.582, "end": 2.674}, {"text": "Hungary", "start": 2.6849999999999996, "end": 2.9320000000000004}, {"text": "in", "start": 2.9589999999999996, "end": 3.0519999999999996}, {"text": "nineteen", "start": 3.062, "end": 3.3400000000000003}, {"text": "forty", "start": 3.371, "end": 3.5570000000000004}, {"text": "six", "start": 3.5770000000000004, "end": 3.7009999999999996}, {"text": "it", "start": 3.715, "end": 3.807}, {"text": "was", "start": 3.8179999999999996, "end": 3.941}, {"text": "even", "start": 3.955, "end": 4.109}, {"text": "worse.", "start": 4.127, "end": 4.343}]}, {"id": "b03", "text": "Prices tripled every day.", "start": 4.953, "end": 6.253, "words": [{"text": "Prices", "start": 4.953, "end": 5.173}, {"text": "tripled", "start": 5.173, "end": 5.433}, {"text": "every", "start": 5.433, "end": 5.933}, {"text": "day.", "start": 5.933, "end": 6.253}]}, {"id": "b04", "text": "A bread that cost one coin this morning cost three coins tomorrow.", "start": 6.7810000000000015, "end": 9.501, "words": [{"text": "A", "start": 6.7810000000000015, "end": 6.861}, {"text": "bread", "start": 6.861, "end": 7.021}, {"text": "that", "start": 7.021, "end": 7.1610000000000005}, {"text": "cost", "start": 7.1610000000000005, "end": 7.341000000000001}, {"text": "one", "start": 7.341000000000001, "end": 7.601000000000001}, {"text": "coin", "start": 7.601000000000001, "end": 7.861000000000001}, {"text": "this", "start": 7.861000000000001, "end": 8.041}, {"text": "morning", "start": 8.041, "end": 8.221}, {"text": "cost", "start": 8.221, "end": 8.501}, {"text": "three", "start": 8.501, "end": 8.821000000000002}, {"text": "coins", "start": 8.821000000000002, "end": 9.081000000000001}, {"text": "tomorrow.", "start": 9.081000000000001, "end": 9.501}]}, {"id": "b05", "text": "So people got paid and ran to the shop the same hour.", "start": 10.133000000000001, "end": 12.293000000000001, "words": [{"text": "So", "start": 10.133000000000001, "end": 10.233}, {"text": "people", "start": 10.233, "end": 10.453}, {"text": "got", "start": 10.453, "end": 10.713000000000001}, {"text": "paid", "start": 10.713000000000001, "end": 10.913}, {"text": "and", "start": 10.913, "end": 11.133000000000001}, {"text": "ran", "start": 11.133000000000001, "end": 11.253}, {"text": "to", "start": 11.253, "end": 11.413000000000002}, {"text": "the", "start": 11.413000000000002, "end": 11.493}, {"text": "shop", "start": 11.493, "end": 11.633000000000003}, {"text": "the", "start": 11.633000000000003, "end": 11.833}, {"text": "same", "start": 11.833, "end": 12.033}, {"text": "hour.", "start": 12.033, "end": 12.293000000000001}]}, {"id": "b06", "text": "The government printed a banknote with twenty zeros on it.", "start": 12.817, "end": 15.399000000000001, "words": [{"text": "The", "start": 12.817, "end": 12.976}, {"text": "government", "start": 12.993, "end": 13.430000000000001}, {"text": "printed", "start": 13.478, "end": 13.795}, {"text": "a", "start": 13.831, "end": 13.910000000000002}, {"text": "banknote", "start": 13.919, "end": 14.276000000000002}, {"text": "with", "start": 14.315, "end": 14.514}, {"text": "twenty", "start": 14.536, "end": 14.813}, {"text": "zeros", "start": 14.844, "end": 15.082}, {"text": "on", "start": 15.109, "end": 15.228}, {"text": "it.", "start": 15.241, "end": 15.399000000000001}]}, {"id": "b07", "text": "But it was still not enough.", "start": 15.839000000000002, "end": 17.479, "words": [{"text": "But", "start": 15.839000000000002, "end": 16.059}, {"text": "it", "start": 16.059, "end": 16.359}, {"text": "was", "start": 16.359, "end": 16.499}, {"text": "still", "start": 16.499, "end": 16.819}, {"text": "not", "start": 16.819, "end": 17.099}, {"text": "enough.", "start": 17.099, "end": 17.479}]}, {"id": "b08", "text": "So they threw the whole money away and made a new one.", "start": 17.958999999999996, "end": 19.779, "words": [{"text": "So", "start": 17.958999999999996, "end": 18.079}, {"text": "they", "start": 18.079, "end": 18.178999999999995}, {"text": "threw", "start": 18.178999999999995, "end": 18.338999999999995}, {"text": "the", "start": 18.338999999999995, "end": 18.478999999999996}, {"text": "whole", "start": 18.478999999999996, "end": 18.618999999999996}, {"text": "money", "start": 18.618999999999996, "end": 18.778999999999996}, {"text": "away", "start": 18.778999999999996, "end": 19.039}, {"text": "and", "start": 19.039, "end": 19.259}, {"text": "made", "start": 19.259, "end": 19.399}, {"text": "a", "start": 19.399, "end": 19.499}, {"text": "new", "start": 19.499, "end": 19.618999999999996}, {"text": "one.", "start": 19.618999999999996, "end": 19.779}]}, {"id": "b09", "text": "One new coin was worth a four with twenty nine zeros of the old money.", "start": 20.228999999999996, "end": 23.199, "words": [{"text": "One", "start": 20.228999999999996, "end": 20.380999999999997}, {"text": "new", "start": 20.397999999999996, "end": 20.549999999999997}, {"text": "coin", "start": 20.566999999999997, "end": 20.756999999999998}, {"text": "was", "start": 20.777999999999995, "end": 20.929999999999996}, {"text": "worth", "start": 20.946999999999996, "end": 21.175}, {"text": "a", "start": 21.200999999999997, "end": 21.276999999999997}, {"text": "four", "start": 21.285, "end": 21.474999999999998}, {"text": "with", "start": 21.497, "end": 21.686999999999998}, {"text": "twenty", "start": 21.708, "end": 21.974}, {"text": "nine", "start": 22.004, "end": 22.194}, {"text": "zeros", "start": 22.215, "end": 22.443}, {"text": "of", "start": 22.467999999999996, "end": 22.583000000000002}, {"text": "the", "start": 22.595, "end": 22.746999999999996}, {"text": "old", "start": 22.764, "end": 22.915999999999997}, {"text": "money.", "start": 22.933, "end": 23.199}]}, {"id": "b10", "text": "And the old banknotes were so worthless that street cleaners swept them off the road like leaves.", "start": 23.668999999999997, "end": 27.338999999999995, "words": [{"text": "And", "start": 23.668999999999997, "end": 23.805}, {"text": "the", "start": 23.82, "end": 23.955999999999996}, {"text": "old", "start": 23.970999999999997, "end": 24.107}, {"text": "banknotes", "start": 24.121999999999996, "end": 24.461999999999996}, {"text": "were", "start": 24.5, "end": 24.67}, {"text": "so", "start": 24.687999999999995, "end": 24.789999999999996}, {"text": "worthless", "start": 24.802, "end": 25.141}, {"text": "that", "start": 25.178999999999995, "end": 25.349}, {"text": "street", "start": 25.367999999999995, "end": 25.606}, {"text": "cleaners", "start": 25.631999999999998, "end": 25.937999999999995}, {"text": "swept", "start": 25.972, "end": 26.176000000000002}, {"text": "them", "start": 26.199, "end": 26.368}, {"text": "off", "start": 26.386999999999997, "end": 26.523}, {"text": "the", "start": 26.538, "end": 26.674}, {"text": "road", "start": 26.689, "end": 26.859}, {"text": "like", "start": 26.877999999999997, "end": 27.048000000000002}, {"text": "leaves.", "start": 27.066999999999997, "end": 27.338999999999995}]}, {"id": "b11", "text": "So next time your coffee costs ten cents more just ask yourself", "start": 28.034999999999997, "end": 30.395, "words": [{"text": "So", "start": 28.034999999999997, "end": 28.114999999999995}, {"text": "next", "start": 28.114999999999995, "end": 28.214999999999996}, {"text": "time", "start": 28.214999999999996, "end": 28.414999999999996}, {"text": "your", "start": 28.414999999999996, "end": 28.535}, {"text": "coffee", "start": 28.535, "end": 28.755}, {"text": "costs", "start": 28.755, "end": 29.034999999999997}, {"text": "ten", "start": 29.034999999999997, "end": 29.275}, {"text": "cents", "start": 29.275, "end": 29.435}, {"text": "more", "start": 29.435, "end": 29.735}, {"text": "just", "start": 29.894999999999996, "end": 29.955000000000002}, {"text": "ask", "start": 29.955000000000002, "end": 30.134999999999998}, {"text": "yourself", "start": 30.134999999999998, "end": 30.395}]}], "gaps": [], "maxgap": 0.3, "tempo": 1.08}