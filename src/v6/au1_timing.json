cked", "start": 35.026999999999994, "end": 35.385999999999996}, {"text": "this", "start": 35.425999999999995, "end": 35.65}, {"text": "and", "start": 35.675, "end": 35.855}, {"text": "poor", "start": 35.875, "end": 36.099}, {"text": "families", "start": 36.123999999999995, "end": 36.528}, {"text": "pay", "start": 36.573, "end": 36.751999999999995}, {"text": "about", "start": 36.772, "end": 37.041}, {"text": "five", "start": 37.071, "end": 37.294999999999995}, {"text": "and", "start": 37.32, "end": 37.5}, {"text": "a", "start": 37.519999999999996, "end": 37.608999999999995}, {"text": "half", "start": 37.619, "end": 37.843999999999994}, {"text": "percent", "start": 37.869, "end": 38.227}, {"text": "more", "start": 38.266999999999996, "end": 38.492}, {"text": "for", "start": 38.516, "end": 38.696}, {"text": "every", "start": 38.715999999999994, "end": 38.985}, {"text": "roll.", "start": 39.015, "end": 39.284}]}, {"id": "c1_06", "text": "Rich families catch the sale more often because they have spare cash on the day the sale happens.", "start": 40.00425, "end": 43.664249999999996, "words": [{"text": "Rich", "start": 40.004, "end": 40.123999999999995}, {"text": "families", "start": 40.123999999999995, "end": 40.384}, {"text": "catch", "start": 40.384, "end": 40.684}, {"text": "the", "start": 40.684, "end": 40.884}, {"text": "sale", "start": 40.884, "end": 41.044}, {"text": "more", "start": 41.044, "end": 41.224}, {"text": "often", "start": 41.224, "end": 41.464}, {"text": "because", "start": 41.464, "end": 41.824}, {"text": "they", "start": 41.824, "end": 42.004}, {"text": "have", "start": 42.004, "end": 42.104}, {"text": "spare", "start": 42.104, "end": 42.324}, {"text": "cash", "start": 42.324, "end": 42.523999999999994}, {"text": "on", "start": 42.523999999999994, "end": 42.763999999999996}, {"text": "the", "start": 42.763999999999996, "end": 42.864}, {"text": "day", "start": 42.864, "end": 43.004}, {"text": "the", "start": 43.004, "end": 43.144}, {"text": "sale", "st