{"fps": 30, "total": 28.599907500000004, "hash": "ee8f429274deb547", "chapters": [], "beats": [{"id": "b01", "text": "What if you opened your bank app and saw ten million dollars?", "start": 0.054000000000000006, "end": 2.0639999999999996, "words": [{"text": "What", "start": 0.054000000000000006, "end": 0.20200000000000004}, {"text": "if", "start": 0.21900000000000003, "end": 0.30700000000000005}, {"text": "you", "start": 0.317, "end": 0.436}, {"text": "opened", "start": 0.44899999999999995, "end": 0.6560000000000001}, {"text": "your", "start": 0.6789999999999999, "end": 0.8270000000000001}, {"text": "bank", "start": 0.844, "end": 0.9920000000000001}, {"text": "app", "start": 1.008, "end": 1.127}, {"text": "and", "start": 1.14, "end": 1.258}, {"text": "saw", "start": 1.271, "end": 1.3899999999999997}, {"text": "ten", "start": 1.403, "end": 1.521}, {"text": "million", "start": 1.535, "end": 1.772}, {"text": "dollars?", "start": 1.798, "end": 2.0639999999999996}]}, {"id": "b02", "text": "Because that really happened to a woman in Australia.", "start": 3.1580000000000004, "end": 4.978000000000001, "words": [{"text": "Because", "start": 3.1580000000000004, "end": 3.3579999999999997}, {"text": "that", "start": 3.3579999999999997, "end": 3.518}, {"text": "really", "start": 3.518, "end": 3.7180000000000004}, {"text": "happened", "start": 3.7180000000000004, "end": 4.038}, {"text": "to", "start": 4.038, "end": 4.238}, {"text": "a", "start": 4.238, "end": 4.3180000000000005}, {"text": "woman", "start": 4.3180000000000005, "end": 4.518}, {"text": "in", "start": 4.518, "end": 4.618}, {"text": "Australia.", "start": 4.618, "end": 4.978000000000001}]}, {"id": "b03", "text": "A crypto company owed her a one hundred dollar refund.", "start": 5.542, "end": 7.651, "words": [{"text": "A", "start": 5.542, "end": 5.612}, {"text": "crypto", "start": 5.62, "end": 5.865}, {"text": "company", "start": 5.892, "end": 6.172000000000001}, {"text": "owed", "start": 6.203, "end": 6.3790000000000