": 14.921}, {"text": "seven", "start": 14.921, "end": 15.161}, {"text": "whole", "start": 15.161, "end": 15.361}, {"text": "months.", "start": 15.361, "end": 15.581}]}, {"id": "b07", "text": "So she bought a mansion with a gym and a cinema.", "start": 16.193, "end": 18.252999999999997, "words": [{"text": "So", "start": 16.193, "end": 16.333000000000002}, {"text": "she", "start": 16.473, "end": 16.553}, {"text": "bought", "start": 16.553, "end": 16.713}, {"text": "a", "start": 16.713, "end": 16.793}, {"text": "mansion", "start": 16.793, "end": 17.093}, {"text": "with", "start": 17.093, "end": 17.353}, {"text": "a", "start": 17.353, "end": 17.452999999999996}, {"text": "gym", "start": 17.452999999999996, "end": 17.633}, {"text": "and", "start": 17.633, "end": 17.933}, {"text": "a", "start": 17.933, "end": 18.032999999999998}, {"text": "cinema.", "start": 18.032999999999998, "end": 18.252999999999997}]}, {"id": "b08", "text": "But then an audit found the mistake.", "start": 18.836999999999996, "end": 19.997, "words": [{"text": "But", "start": 18.836999999999996, "end": 18.916999999999998}, {"text": "then", "start": 18.916999999999998, "end": 19.017}, {"text": "an", "start": 19.017, "end": 19.116999999999997}, {"text": "audit", "start": 19.116999999999997, "end": 19.337}, {"text": "found", "start": 19.337, "end": 19.617}, {"text": "the", "start": 19.617, "end": 19.757}, {"text": "mistake.", "start": 19.757, "end": 19.997}]}, {"id": "b09", "text": "And the court made her pay it all back with interest and they sold the house.", "start": 20.512999999999998, "end": 22.933, "words": [{"text": "And", "start": 20.512999999999998, "end": 20.592999999999996}, {"text": "the", "start": 20.592999999999996, "end": 20.652999999999995}, {"text": "court", "start": 20.652999999999995, "end": 20.792999999999996}, {"text": "made", "start": 20.792999999999996, "end": 21.012999999999998}, {"text": "her", "start": 21.012999999999998, "end": 21.173}, {"text": "pay", "start": 21.173, "end": 21.312999999999995}, {"text": "it", "start": 21.312999999999995, "end": 21.453}, {"text": "all", "start": 21.453, "end": 21.532999999999998}, {"text": "back", "start": 21.532999999999998, "end": 21.733}, {"text": "with", "start": 21.733, "end": 21.873}, {"text": "interest", "start": 21.873, "end": 22.113}, {"text": "and", "start": 22.113, "end": 22.352999999999998}, {"text": "they", "start": 22.352999999999998, "end": 22.452999999999996}, {"text": "sold", "start": 22.452999999999996, "end": 22.592999999999996}, {"text": "the", "start": 22.592999999999996, "end": 22.732999999999997}, {"text": "house.", "start": 22.732999999999997, "end": 22.933}]}, {"id": "b10", "text": "Because money that lands by mistake is never yours.", "start": 23.549, "end": 26.028999999999996, "words": [{"text": "Because", "start": 23.549, "end": 23.808999999999997}, {"text": "money", "start": 23.808999999999997, "end": 24.188999999999997}, {"text": "that", "start": 24.188999999999997, "end": 24.348999999999997}, {"text": "lands", "start": 24.348999999999997, "end": 24.548999999999996}, {"text": "by", "start": 24.548999999999996, "end": 24.749}, {"text": "mistake", "start": 24.749, "end": 25.109}, {"text": "is", "start": 25.109, "end": 25.409}, {"text": "never", "start": 25.409, "end": 25.709}, {"text": "yours.", "start": 25.709, "end": 26.028999999999996}]}, {"id": "b11", "text": "So if it ever happens to you just ask yourself", "start": 26.628999999999998, "end": 28.269, "words": [{"text": "So", "start": 26.628999999999998, "end": 26.708999999999996}, {"text": "if", "start": 26.708999999999996, "end": 26.809}, {"text": "it", "start": 26.809, "end": 26.868999999999996}, {"text": "ever", "start": 26.868999999999996, "end": 27.049}, {"text": "happens", "start": 27.049, "end": 27.308999999999997}, {"text": "to", "start": 27.308999999999997, "end": 27.509}, {"text": "you", "start": 27.509, "end": 27.629}, {"text": "just", "start": 27.709, "end": 27.828999999999997}, {"text": "ask", "start": 27.828999999999997, "end": 28.009}, {"text": "yourself", "start": 28.009, "end": 28.269}]}], "gaps": [], "maxgap": 0.3, "tempo": 1.08}